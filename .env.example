# Local example; use separate restricted credentials outside development.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/tucano_b3
B3_API_DATABASE_URL=postgres://postgres:postgres@b3_postgres:5432/tucano_b3
B3_WORKER_DATABASE_URL=postgres://postgres:postgres@b3_postgres:5432/tucano_b3
B3_MIGRATION_DATABASE_URL=postgres://postgres:postgres@b3_postgres:5432/tucano_b3
B3_TEST_DATABASE_URL=postgres://postgres:postgres@b3_postgres:5432/tucano_b3_test
B3_ALLOWED_HOSTS=www.b3.com.br,b3.com.br,bvmf.bmfbovespa.com.br,arquivos.b3.com.br,sistemaswebb3-listados.b3.com.br
B3_RAW_DATA_DIR=/data/raw
B3_PROCESSED_DATA_DIR=/data/processed
B3_DISCOVERY_ENABLED=false
# Semicolon- or comma-separated folder:/absolute/path, b3_url:https://.../COTAHIST_A2025.ZIP,
# object_storage_bucket:s3://bucket/prefix entries. Compose mounts ./data/imports read-only.
B3_DISCOVERY_LOCATIONS=folder:/data/raw/imports
B3_DB_MAX_CONNECTIONS=8
B3_API_DB_ACQUIRE_TIMEOUT_SECONDS=5
B3_API_DB_STATEMENT_TIMEOUT_SECONDS=30
B3_WORKER_DB_MAX_CONNECTIONS=16
B3_WORKER_DB_ACQUIRE_TIMEOUT_SECONDS=30
B3_WORKER_DB_STATEMENT_TIMEOUT_SECONDS=600
B3_BATCH_RECORDS=500
B3_BATCH_BYTES=4194304
B3_WORKER_LEASE_SECONDS=1800
AWS_REGION=us-east-1
# Optional custom endpoint for AWS S3-compatible services.
AWS_ENDPOINT_URL_S3=
# Optional read-only object-listing credentials; the default AWS credential chain also works.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
TUCANO_B3_READ_TOKEN=
TUCANO_B3_ADMIN_TOKEN=

# COTAHIST ZIP archives in S3-compatible storage (Cloudflare R2).
# Ingestion does not run until POST /api/v1/ingest/bucket.
# TUCANO_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# TUCANO_S3_BUCKET=cotahist
# TUCANO_S3_REGION=auto
# TUCANO_S3_ACCESS_KEY_ID=
# TUCANO_S3_SECRET_ACCESS_KEY=
# TUCANO_S3_PREFIX=cotahist/
# TUCANO_S3_FORCE_PATH_STYLE=true
RUST_LOG=info
# Sources, evidence, profiles and calendar are registered explicitly; none is enabled by seed.
